#!/bin/bash
# Close the overlay first, then paste into the window that was focused when
# the picker opened. Clipboard + Shift+Insert is what actually injects Unicode;
# a virtual keyboard cannot type emoji codepoints.
set -u

address="${1:-}"
emoji="${2:-}"
insert="${3:-}"

[[ -n $emoji ]] || exit 1

sleep 0.12
if [[ -n $address ]]; then
  hyprctl dispatch focuswindow "address:$address" >/dev/null 2>&1 || true
  sleep 0.06
fi

if [[ -n $insert && -x $insert ]]; then
  exec "$insert" "$emoji"
fi

printf '%s' "$emoji" | wl-copy --type text/plain --sensitive --foreground &
copy_pid=$!
sleep 0.15
wtype -M shift -k Insert -m shift 2>/dev/null || true
sleep 0.2
kill "$copy_pid" 2>/dev/null || true
