#!/bin/bash
# Paste once into whichever client still has the keyboard.
# The overlay must not steal focus; a virtual keyboard cannot type emoji
# codepoints, so this copies then sends a single Shift+Insert.
set -u

emoji="${1:-}"
[[ -n $emoji ]] || exit 1

printf '%s' "$emoji" | wl-copy --type text/plain --sensitive
sleep 0.05
wtype -M shift -k Insert -m shift
